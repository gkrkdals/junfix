// Prisma 스키마 (MariaDB / MySQL 호환)
//
// 배열 성격의 컬럼(symptoms, causes, workProcess, equipment)은
// JSON 문자열을 담은 TEXT 로 저장한다. MariaDB 의 JSON 은 LONGTEXT 별칭이라
// 네이티브 Json 타입을 쓰는 것보다 이 편이 드라이버 호환성이 안정적이다.
// 직렬화/역직렬화는 lib/repository.ts 의 코덱이 전담한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. 관리자 계정
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  // scrypt 해시. 형식: scrypt:<saltHex>:<hashHex> (lib/password.ts)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("admin") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// 2. 사이트 기본 설정 및 업체 정보 (단일 행으로 운용)
//    전화번호/카톡/블로그/지역 등 화면에 노출되는 값은 전부 여기서 읽는다.
model SiteSetting {
  id                 Int    @id @default(autoincrement())
  siteName           String @default("준픽스 (JUNFIX)") @map("site_name") @db.VarChar(100)
  tagline            String @default("막힘은 해결하고, 일상은 흐르게") @db.VarChar(200)
  representativeName String @default("염준혁") @map("representative_name") @db.VarChar(50)
  phoneNumber        String @default("010-2703-1491") @map("phone_number") @db.VarChar(30)
  telNumber          String @default("010-2703-1491") @map("tel_number") @db.VarChar(30)
  kakaoTalkUrl       String @default("") @map("kakao_talk_url") @db.VarChar(255)
  naverBlogUrl       String @default("") @map("naver_blog_url") @db.VarChar(255)
  businessNumber     String @default("") @map("business_number") @db.VarChar(50)
  address            String @default("") @db.VarChar(200)

  // --- 확장 필드 ---------------------------------------------------------
  siteUrl                String @default("") @map("site_url") @db.VarChar(255)
  email                  String @default("") @db.VarChar(100)
  businessHours          String @default("평일·주말 24시간 상담 가능") @map("business_hours") @db.VarChar(100)
  // 서비스 가능 지역 목록. 줄바꿈 구분 텍스트.
  serviceAreaList        String @default("") @map("service_area_list") @db.Text
  logoImageUrl           String @default("") @map("logo_image_url") @db.VarChar(512)
  heroImageUrl           String @default("") @map("hero_image_url") @db.VarChar(512)
  // 상담 접수 알림을 받을 이메일 (비어 있으면 NOTIFY_EMAIL 환경변수)
  notifyEmail            String @default("") @map("notify_email") @db.VarChar(100)
  // 전환 측정 / 검색엔진 등록
  gaMeasurementId        String @default("") @map("ga_measurement_id") @db.VarChar(50)
  gtmId                  String @default("") @map("gtm_id") @db.VarChar(50)
  naverAnalyticsId       String @default("") @map("naver_analytics_id") @db.VarChar(50)
  googleAdsSendTo        String @default("") @map("google_ads_send_to") @db.VarChar(100)
  naverSiteVerification  String @default("") @map("naver_site_verification") @db.VarChar(100)
  googleSiteVerification String @default("") @map("google_site_verification") @db.VarChar(100)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_settings")
}

// 3. 서비스 마스터 (하수구, 싱크대, 변기, 에어컨 등)
model Service {
  id               Int         @id @default(autoincrement())
  slug             String      @unique @db.VarChar(50)
  category         String      @db.VarChar(50) // 'plumbing' | 'aircon'
  title            String      @db.VarChar(100)
  subtitle         String      @db.VarChar(200)
  iconName         String      @map("icon_name") @db.VarChar(50)
  symptoms         String      @db.Text // JSON 문자열 배열
  causes           String      @db.Text // JSON 문자열 배열
  inspectionMethod String      @map("inspection_method") @db.Text
  workProcess      String      @map("work_process") @db.Text // JSON 문자열 배열
  equipment        String      @db.Text // JSON 문자열 배열
  imageUrl         String      @default("") @map("image_url") @db.VarChar(512)
  orderNum         Int         @default(0) @map("order_num")
  isActive         Boolean     @default(true) @map("is_active")
  caseStudies      CaseStudy[]

  @@index([isActive, orderNum])
  @@map("services")
}

// 4. 시공사례 (Before & After)
model CaseStudy {
  id              Int      @id @default(autoincrement())
  serviceId       Int?     @map("service_id")
  title           String   @db.VarChar(200)
  serviceCategory String   @map("service_category") @db.VarChar(100)
  region          String   @db.VarChar(100)
  symptom         String   @db.VarChar(255)
  cause           String   @db.Text
  // 작업 과정
  workProcess     String   @default("") @map("work_process") @db.Text
  // 해결 결과
  solution        String   @db.Text
  equipment       String   @db.VarChar(255)
  beforeImageUrl  String   @default("") @map("before_image_url") @db.VarChar(512)
  afterImageUrl   String   @default("") @map("after_image_url") @db.VarChar(512)
  // 작업 과정 사진 URL 목록 (JSON 문자열 배열)
  processImages   String   @default("[]") @map("process_images") @db.Text
  naverBlogLink   String   @default("") @map("naver_blog_link") @db.VarChar(255)
  date            String   @db.VarChar(30)
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([isFeatured, createdAt])
  @@map("case_studies")
}

// 5. 작업비용 안내
model PricingItem {
  id           Int     @id @default(autoincrement())
  serviceName  String  @map("service_name") @db.VarChar(100)
  category     String  @default("fixed") @db.VarChar(50) // 'fixed' | 'quote'
  priceDisplay String  @map("price_display") @db.VarChar(100)
  description  String  @db.VarChar(255)
  notice       String  @default("") @db.VarChar(255)
  orderNum     Int     @default(0) @map("order_num")
  isActive     Boolean @default(true) @map("is_active")

  @@index([isActive, orderNum])
  @@map("pricing_items")
}

// 6. 고객 후기
model Review {
  id           Int      @id @default(autoincrement())
  customerName String   @map("customer_name") @db.VarChar(50)
  region       String   @default("") @db.VarChar(50)
  serviceType  String   @default("") @map("service_type") @db.VarChar(50)
  rating       Int      @default(5)
  comment      String   @db.Text
  date         String   @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([isActive, createdAt])
  @@map("reviews")
}

// 7. 고객 상담/출동 접수
model Inquiry {
  id            Int      @id @default(autoincrement())
  customerName  String   @map("customer_name") @db.VarChar(50)
  phoneNumber   String   @map("phone_number") @db.VarChar(30)
  region        String   @db.VarChar(100)
  serviceType   String   @map("service_type") @db.VarChar(100)
  description   String   @default("") @db.Text
  preferredTime String   @default("") @map("preferred_time") @db.VarChar(100)
  status        String   @default("접수완료") @db.VarChar(20)
  memo          String   @default("") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("inquiries")
}

/// 업체 사진 갤러리 (작업차량, 장비, 현장 사진). 소개 섹션에 노출.
model SitePhoto {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(512)
  caption   String   @default("") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isActive, sortOrder])
  @@map("site_photos")
}

/// 업로드된 파일 목록. 실제 파일은 UPLOAD_DIR 에 있고 여기엔 메타데이터만 둔다.
model MediaAsset {
  id           Int      @id @default(autoincrement())
  url          String   @unique @db.VarChar(512)
  originalName String   @default("") @map("original_name") @db.VarChar(255)
  mimeType     String   @default("") @map("mime_type") @db.VarChar(50)
  width        Int      @default(0)
  height       Int      @default(0)
  size         Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("media_assets")
}

/// 시드 적용 이력. 초기 데이터 적재를 딱 한 번만 수행하기 위한 마커.
/// 이게 없으면 관리자가 지운 데이터가 다음 배포 때 되살아난다.
model SeedState {
  key       String   @id @db.VarChar(50)
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("seed_state")
}
