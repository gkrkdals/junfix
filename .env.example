# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해서 사용한다. (.env 는 git 에 커밋되지 않음)
#   로컬:  cp .env.example .env
#   서버:  /opt/junpiks/.env 를 최초 1회 수동 생성 (배포 시 덮어쓰지 않음)
# ---------------------------------------------------------------------------

# --- 도메인 / HTTPS --------------------------------------------------------
# 인증서를 발급받을 기본 도메인. 인증서 경로 이름으로도 쓰인다.
DOMAIN=example.com

# nginx server_name 과 인증서에 포함할 호스트 목록 (공백 구분).
# www 도 함께 쓰려면 아래처럼 둘 다 적는다. 비워두면 DOMAIN 하나만 사용.
SERVER_NAMES="example.com www.example.com"

# 인증서 만료 알림을 받을 이메일 (Let's Encrypt 필수 입력)
CERTBOT_EMAIL=admin@example.com

# 1 로 두면 Let's Encrypt staging 환경을 쓴다.
# 발급 횟수 제한에 걸리지 않고 연습할 때만 사용 (브라우저는 신뢰하지 않음).
CERTBOT_STAGING=0

# 사이트맵/OG 에 쓰이는 공개 주소. 비워두면 https://${DOMAIN} 을 쓴다.
# 관리자 > 기본 정보 > 홈페이지 주소를 입력하면 그 값이 우선한다.
SITE_URL=

# --- MariaDB 컨테이너 ------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=junpics
MARIADB_USER=devuser
MARIADB_PASSWORD=change-me-user

# DB 포트 바인딩 주소.
#   127.0.0.1 = 서버 내부에서만 접속 (권장, 기본값)
#   0.0.0.0   = 인터넷에 3306 공개 (로컬 PC 에서 직접 붙어야 할 때만)
MARIADB_BIND=127.0.0.1

# --- 관리자 계정 -----------------------------------------------------------
# 배포(migrate 서비스)할 때마다 이 값으로 관리자 비밀번호가 재설정된다.
# 비밀번호를 바꾸려면 이 값을 바꾸고 재배포하면 된다.
ADMIN_USERNAME=junpiks
ADMIN_PASSWORD=change-me-admin

# 관리자 세션 쿠키 서명키. 아래 명령으로 생성한다.
#   openssl rand -hex 32
# 값이 바뀌면 로그인된 관리자 세션이 전부 풀린다.
ADMIN_SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- 상담 접수 이메일 알림 (선택) --------------------------------------------
# 비워두면 알림 없이 접수만 저장된다 (관리자 페이지에서 확인).
# 수신 주소는 관리자 > 기본 정보 > "알림 받을 이메일" 이 우선이고, 없으면 NOTIFY_EMAIL.
#
# 네이버 메일:  SMTP_HOST=smtp.naver.com  SMTP_PORT=465  SMTP_SECURE=1
#              (네이버 메일 > 환경설정 > POP3/IMAP 설정 > "사용함" 필요)
# Gmail:       SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=1
#              (구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 발급, 그 값을 SMTP_PASS 에)
# 발신: 개발자 Gmail 계정 (구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 발급)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=발신용계정@gmail.com
SMTP_PASS=16자리-앱-비밀번호
# 보내는 사람 표시. Gmail 은 주소를 SMTP_USER 로 강제하므로 이름만 바꿀 수 있다.
SMTP_FROM="준픽스 홈페이지 <발신용계정@gmail.com>"
# 수신: 사장님 메일. 관리자 페이지 > 기본 정보 > 알림 받을 이메일이 우선한다.
NOTIFY_EMAIL=wnsgur0197@naver.com

# --- 애플리케이션 ----------------------------------------------------------
# compose 는 위 MARIADB_* 값으로 DATABASE_URL 을 자동 조립한다.
# 아래 값은 docker 없이 `npm run dev` 로 돌릴 때만 사용된다.
DATABASE_URL="mysql://devuser:change-me-user@127.0.0.1:3306/junpics"

# 업로드 사진 저장 폴더. compose 는 /app/uploads (uploads_data 볼륨) 를 쓴다.
# 로컬 개발 시 비워두면 프로젝트의 ./uploads 를 쓴다.
UPLOAD_DIR=
