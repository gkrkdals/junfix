# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해서 사용한다. (.env 는 git 에 커밋되지 않음)
#   로컬:  cp .env.example .env
#   서버:  /opt/junpiks/.env 를 최초 1회 수동 생성 (배포 시 덮어쓰지 않음)
# ---------------------------------------------------------------------------

# --- MariaDB 컨테이너 ------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=junpics
MARIADB_USER=devuser
MARIADB_PASSWORD=change-me-user

# DB 포트 바인딩 주소.
#   127.0.0.1 = 서버 내부에서만 접속 (권장, 기본값)
#   0.0.0.0   = 인터넷에 3306 공개 (로컬 PC 에서 직접 붙어야 할 때만)
MARIADB_BIND=127.0.0.1

# --- 관리자 계정 -----------------------------------------------------------
# 배포(migrate 서비스)할 때마다 이 값으로 관리자 비밀번호가 재설정된다.
# 비밀번호를 바꾸려면 이 값을 바꾸고 재배포하면 된다.
ADMIN_USERNAME=junpiks
ADMIN_PASSWORD=change-me-admin

# 관리자 세션 쿠키 서명키. 아래 명령으로 생성한다.
#   openssl rand -hex 32
# 값이 바뀌면 로그인된 관리자 세션이 전부 풀린다.
ADMIN_SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- 애플리케이션 ----------------------------------------------------------
# compose 는 위 MARIADB_* 값으로 DATABASE_URL 을 자동 조립한다.
# 아래 값은 docker 없이 `npm run dev` 로 돌릴 때만 사용된다.
DATABASE_URL="mysql://devuser:change-me-user@127.0.0.1:3306/junpics"
