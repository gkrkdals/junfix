# ---------------------------------------------------------------------------
# junpiks - nginx (HTTPS 종단 + Next.js 리버스 프록시)
#
# 이 파일은 템플릿이다. nginx 공식 이미지가 기동 시 envsubst 로
# ${DOMAIN} / ${SERVER_NAMES} 를 치환해 /etc/nginx/conf.d/default.conf 를 만든다.
# 치환 대상은 compose 의 NGINX_ENVSUBST_FILTER 로 제한되어 있으므로
# $host, $remote_addr 같은 nginx 변수는 그대로 남는다.
# ---------------------------------------------------------------------------

upstream next_upstream {
    server next-app:3000;
    keepalive 32;
}

# --- HTTP : 인증서 갱신 경로와 헬스체크만 처리하고 나머지는 HTTPS 로 보낸다 ---
server {
    listen 80;
    server_name ${SERVER_NAMES};

    # Let's Encrypt HTTP-01 challenge (갱신 시 계속 필요하므로 상시 열어둔다)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # 배포 스크립트/모니터링용. 리다이렉트 없이 200 을 준다.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS : 실제 서비스 -----------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAMES};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    client_max_body_size 20m;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml font/woff2;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 파일명에 해시가 붙는 빌드 산출물 - Next.js 가 immutable 헤더를 직접 내려준다
    location /_next/static/ {
        include /etc/nginx/snippets/proxy_headers.inc;
        proxy_http_version 1.1;
        proxy_set_header Connection "";     # upstream keepalive 사용
        proxy_pass http://next_upstream;
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    # public/images 정적 자산
    location /images/ {
        include /etc/nginx/snippets/proxy_headers.inc;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://next_upstream;
        # upstream 의 max-age=0 을 그대로 두면 매 요청마다 재검증하므로 교체한다
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=86400";
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    location / {
        include /etc/nginx/snippets/proxy_headers.inc;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # SSR 스트리밍 응답이 끊기지 않도록
        proxy_buffering off;

        proxy_pass http://next_upstream;

        # HTTPS 강제. 한 번 적용되면 브라우저가 180일간 기억하므로,
        # HTTPS 를 내릴 계획이 있다면 이 줄을 먼저 제거하고 기간만큼 기다려야 한다.
        add_header Strict-Transport-Security "max-age=15552000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
